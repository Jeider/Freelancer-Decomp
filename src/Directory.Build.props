<Project>
  <PropertyGroup>
    <!-- Default for projects without the shared diagnostics property sheet. -->
    <FreelancerEnableTickProfile Condition="'$(FreelancerEnableTickProfile)'==''">0</FreelancerEnableTickProfile>
    <!-- Port-only "Beta 2" on-screen label, FREELANCER_BETA_LABEL; off by default. -->
    <FreelancerBetaLabel Condition="'$(FreelancerBetaLabel)'==''">0</FreelancerBetaLabel>
    <!-- Port-only widescreen (Hor+) support, FREELANCER_WIDESCREEN_SUPPORT; 0 builds retail's 4:3-only client. -->
    <FreelancerWidescreenSupport Condition="'$(FreelancerWidescreenSupport)'==''">1</FreelancerWidescreenSupport>
    <!-- Port-only Direct3D 9 rendering (RP9.dll + the client's Ex hooks: volumetric nebula),
         FREELANCER_RP9; 0 builds neither RP9.dll nor the client hooks (docs/re/rp9.md). -->
    <FreelancerRp9 Condition="'$(FreelancerRp9)'==''">0</FreelancerRp9>
    <!-- Port-only walk mode in base rooms (docs/walk_mode.md), FREELANCER_WALK_MODE; off by default. -->
    <FreelancerWalkMode Condition="'$(FreelancerWalkMode)'==''">0</FreelancerWalkMode>
    <!-- Port-only HUD_Target layout of the HudTarget.dll plugin (docs/hud_plugins.md),
         FREELANCER_HUD_TARGET_VIEW; off by default. -->
    <FreelancerHudTargetView Condition="'$(FreelancerHudTargetView)'==''">0</FreelancerHudTargetView>
    <!-- Port-only ship view in HUD_Status of the HudStatus.dll plugin (docs/hud_plugins.md),
         FREELANCER_HUD_STATUS_VIEW; off by default. -->
    <FreelancerHudStatusView Condition="'$(FreelancerHudStatusView)'==''">0</FreelancerHudStatusView>
    <!-- Port-only ship view mode of NN_Inventory from the HudInventory.dll plugin
         (docs/hud_plugins.md), FREELANCER_HUD_INVENTORY_VIEW; off by default. -->
    <FreelancerHudInventoryView Condition="'$(FreelancerHudInventoryView)'==''">0</FreelancerHudInventoryView>
    <!-- Port-only behaviour of Jason Hood's jflp.dll (docs/jflp.md), FREELANCER_JFLP in the
         client and Common.dll; off by default. -->
    <FreelancerJflp Condition="'$(FreelancerJflp)'==''">0</FreelancerJflp>
    <!-- Port-only behaviour of TheStarport's flplusplus.dll (docs/flplusplus.md),
         FREELANCER_FLPLUSPLUS in the client and Common.dll; off by default. -->
    <FreelancerFlplusplus Condition="'$(FreelancerFlplusplus)'==''">0</FreelancerFlplusplus>
    <!-- Port-only fixes of BC46's FLSharp.dll (docs/flsharp.md), FREELANCER_FLSHARP in the
         client, Common.dll and Server.dll; off by default. -->
    <FreelancerFlsharp Condition="'$(FreelancerFlsharp)'==''">0</FreelancerFlsharp>
    <!-- Port-only beta DBG_OPTIONS window and its [OUTLINES] drawing (docs/dbg_options.md),
         FREELANCER_DBG_OPTIONS in the client and Common.dll; off by default. -->
    <FreelancerDbgOptions Condition="'$(FreelancerDbgOptions)'==''">0</FreelancerDbgOptions>
    <!-- Port-only behaviour of adoxa's plugins (docs/adoxa.md), FREELANCER_ADOXA in the client,
         Common.dll, Server.dll and Content.dll; each plugin is switched in port.ini [Plugins]. -->
    <FreelancerAdoxa Condition="'$(FreelancerAdoxa)'==''">0</FreelancerAdoxa>
    <!-- Port-only armor/scanner/tractor slots; independent of adoxa engclass. -->
    <FreelancerEquipmentSlots Condition="'$(FreelancerEquipmentSlots)'==''">0</FreelancerEquipmentSlots>
    <FreelancerPlayerAutoTurrets Condition="'$(FreelancerPlayerAutoTurrets)'==''">0</FreelancerPlayerAutoTurrets>
    <!-- Port-only behaviour of other mod plugins (AnimKey, MultiCruise, Invisibility, Interceptor,
         PowerDamage; docs/mod_plugins.md), FREELANCER_MOD_PLUGINS; off by default. -->
    <FreelancerModPlugins Condition="'$(FreelancerModPlugins)'==''">0</FreelancerModPlugins>
    <!-- Port-only language switch (docs/language.md): port.ini [Language] picks the client ini,
         resources.dll and per-language data overlays, FREELANCER_LANGUAGE; off by default. -->
    <FreelancerLanguage Condition="'$(FreelancerLanguage)'==''">0</FreelancerLanguage>
    <!-- Port-only camera-relative modelview (docs/precise_render.md): objects far from the system
         centre stop shaking; port.ini [Render] precise_view, FREELANCER_PRECISE_RENDER; off by default. -->
    <FreelancerPreciseRender Condition="'$(FreelancerPreciseRender)'==''">0</FreelancerPreciseRender>
    <!-- Port-only particle improvements (docs/particle_fx.md): soft particles for alchemy effects
         and nebula puffs (RP9), sorted puffs with smooth fades; port.ini [Render], FREELANCER_PARTICLE_FX. -->
    <FreelancerParticleFx Condition="'$(FreelancerParticleFx)'==''">0</FreelancerParticleFx>
    <PlatformToolset>v143</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <CharacterSet>MultiByte</CharacterSet>
    <!-- Output dir name per configuration: Release -> bin, Debug -> bin_debug, DebugASan -> binasan.
         All are siblings at the repo root, so every ..\DATA / ..\EXE path resolves alike. -->
    <FlBinDirName>bin</FlBinDirName>
    <FlBinDirName Condition="'$(Configuration)'=='Debug'">bin_debug</FlBinDirName>
    <FlBinDirName Condition="'$(Configuration)'=='DebugASan'">binasan</FlBinDirName>
    <OutDir>$(MSBuildThisFileDirectory)..\$(FlBinDirName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>
    <PreferredToolArchitecture>x86</PreferredToolArchitecture>
    <!-- DirectX 8.1 SDK (repo-root dx8/, gitignored). Headers via IncludePath append
         (old basetsd.h must not precede the Windows 10 SDK). Override: /p:Dx8SdkDir=... -->
    <Dx8SdkDir Condition="'$(Dx8SdkDir)'==''">$(MSBuildThisFileDirectory)..\dx8</Dx8SdkDir>
    <!-- DirectX SDK June 2010 (RP9 only: D3DX9 headers/import lib, DxErr, d3dx9_43 redist cab).
         Defaults to the installer's DXSDK_DIR (with or without a trailing slash). Its Include dir holds an
         older d3d9.h, so RP9.vcxproj appends it after the Windows SDK. Override: /p:Dx9SdkDir=... -->
    <Dx9SdkDir Condition="'$(Dx9SdkDir)'==''">$(DXSDK_DIR)</Dx9SdkDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>WIN32;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='DebugASan'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- x87 floating point (/arch:IA32), as the VC6-built retail modules. Retail leaves
           FPU_PRESERVE off (EXE\dacom.ini; rp8.dll reads the key at .text:06d06bb4), so
           Direct3D 8 CreateDevice drops the main thread's x87 precision control to 24-bit and
           never restores it. x87 code inherits that; SSE2 code ignores the control word and
           would keep 53-bit doubles where retail has 24-bit. -->
      <EnableEnhancedInstructionSet>NoExtensions</EnableEnhancedInstructionSet>
      <FloatingPointModel>Precise</FloatingPointModel>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OutDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
